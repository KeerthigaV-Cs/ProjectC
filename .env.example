# Copy this file to .env and fill in your own credentials.
# Keep actual API keys and tokens in .env only; never commit them.

# Story generation
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
STORY_PROVIDER=gemini
STORY_FALLBACK_PROVIDER=huggingface

# Image generation
# Default is local generation without external AI calls.
# Set to huggingface to use Hugging Face FLUX for images.
IMAGE_PROVIDER=huggingface
IMAGE_FALLBACK_PROVIDER=huggingface
IMAGE_API_KEY=
IMAGE_MODEL=gemini-3.1-flash-image

# Shared Hugging Face credentials and model overrides
HF_TOKEN=
HF_STORY_MODEL=
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
